  title: "\u7B2C\u4E00\u9053\u5927\u98A8"
  description: "\u8349\u539F\u7684\u76E1\u982D\uFF0C\u98A8\u5FFD\u7136\u6709\u4E86\u91CD\u91CF\u3002\u5B83\u5F9E\u5730\u5E73\u7DDA\u90A3\u7AEF\u58D3\u904E\u4F86\uFF0C\u50CF\u4E00\u96BB\u6C92\u6709\u60E1\u610F\u7684\u5927\u624B\u3002"
  options:
  - title: "\u9806\u8457\u98A8\u8DD1"
    description: "\u8DDF\u5F97\u4E0A\u5B83\u7684\u7BC0\u594F\uFF0C\u5B83\u5C31\u6703\u63A8\u4F60\u4E00\u628A\u3002"
    requirements:
    - stat: 0
      comparison: 0
      tier: 1
    changes:
    - stat: 0
      amount: 1
    lockedText: 
    resultText: "\u4F60\u548C\u98A8\u4E26\u80A9\u8DD1\u4E86\u4E00\u6BB5\u3002\u5B83\u6C92\u6709\u5E36\u8D70\u4F60\uFF0C\u53CD\u800C\u6559\u6703\u4F60\u600E\u9EBC\u501F\u529B\u3002"
    hintText: "\u98A8\u8B8A\u5927\u7684\u6642\u5019\uFF0C\u8DD1\u5F97\u5FEB\u7684\u8349\u7E3D\u6709\u8DEF\u8D70\u3002"
  - title: "\u628A\u6839\u624E\u6DF1"
    description: "\u4F0F\u4F4E\uFF0C\u6293\u4F4F\u571F\uFF0C\u7B49\u5B83\u904E\u53BB\u3002"
    requirements:
    - stat: 2
      comparison: 0
      tier: 1
    changes:
    - stat: 2
      amount: 1
    lockedText: 
    resultText: "\u98A8\u5F9E\u4F60\u982D\u9802\u78BE\u904E\u3002\u4F60\u4E00\u52D5\u4E5F\u4E0D\u52D5\uFF0C\u50CF\u4E00\u9846\u5C0F\u5C0F\u7684\u77F3\u982D\u3002"
    hintText: "\u6490\u5F97\u4F4F\uFF0C\u662F\u53E6\u4E00\u7A2E\u524D\u9032\u3002"
  - title: "\u6536\u650F\u8449\u7247\uFF0C\u542B\u4F4F\u6C34\u6C23"
    description: "\u81F3\u5C11\u8981\u6709\u4E00\u9EDE\u6C34\uFF0C\u624D\u71AC\u5F97\u904E\u9019\u9663\u98A8\u3002"
    requirements:
    - stat: 1
      comparison: 0
      tier: 0
    changes:
    - stat: 2
      amount: -1
    lockedText: 
    resultText: "\u4F60\u628A\u81EA\u5DF1\u7E2E\u5F97\u5F88\u5C0F\u3002\u98A8\u9084\u662F\u626F\u88C2\u4E86\u4F60\u4E00\u7247\u8449\u5B50\uFF0C\u4F46\u4F60\u7559\u4E0B\u4F86\u4E86\u3002"
    hintText: "\u52C9\u5F37\u6490\u904E\u53BB\uFF0C\u4E5F\u662F\u6490\u904E\u53BB\u3002\u53EA\u662F\u8D8A\u5F80\u5F8C\uFF0C\u52C9\u5F37\u6703\u8D8A\u4F86\u8D8A\u96E3\u3002"
