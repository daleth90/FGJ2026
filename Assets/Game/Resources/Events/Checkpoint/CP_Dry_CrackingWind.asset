  m_Name: CP_Dry_CrackingWind
  m_EditorClassIdentifier: GrassRun::GrassRun.EventDefinition
  kind: 1
  zones: 2
  weight: 1
  title: "\u9003\u96E2\u4E7E\u88C2\u98A8\u5E36"
  description: "\u5927\u5730\u88C2\u6210\u4E00\u7247\u7247\u9F9C\u7532\uFF0C\u71B1\u98A8\u8CBC\u8457\u5730\u9762\u522E\u904E\u4F86\uFF0C\u8981\u5E36\u8D70\u6240\u6709\u4E0D\u80AF\u9B06\u624B\u7684\u6C34\u6C23\u3002"
  options:
  - title: "\u52A0\u901F\u63A0\u904E"
    description: "\u8D81\u98A8\u9084\u6C92\u5408\u650F\uFF0C\u5F9E\u88C2\u7E2B\u4E4B\u9593\u885D\u904E\u53BB\u3002\u53EA\u6709\u6700\u5FEB\u7684\u8349\u505A\u5F97\u5230\u3002"
    requirements:
    - stat: 0
      comparison: 0
      tier: 2
    changes:
    - stat: 0
      amount: 1
    - stat: 1
      amount: -1
    lockedText: 
    resultText: "\u4F60\u5FEB\u5F97\u9023\u71B1\u6C23\u90FD\u8FFD\u4E0D\u4E0A\u3002\u53EA\u662F\u885D\u51FA\u4F86\u7684\u6642\u5019\uFF0C\u8449\u5C16\u6709\u9EDE\u767C\u4E7E\u3002"
    hintText: "\u901F\u5EA6\u6551\u4E86\u4F60\uFF0C\u4F46\u5B83\u4E0D\u6703\u66FF\u4F60\u5B58\u6C34\u3002"
  - title: "\u8CBC\u5730\u530D\u5310"
    description: "\u58D3\u4F4E\u8EAB\u5B50\uFF0C\u8B93\u98A8\u5F9E\u80CC\u4E0A\u6ED1\u904E\u53BB\u3002\u5F97\u5920\u8010\u78E8\u3002"
    requirements:
    - stat: 2
      comparison: 0
      tier: 1
    changes:
    - stat: 2
      amount: -1
    lockedText: 
    resultText: "\u7802\u792B\u78E8\u904E\u4F60\u7684\u6BCF\u4E00\u7247\u8449\u5B50\u3002\u4F60\u6490\u4F4F\u4E86\uFF0C\u8EAB\u4E0A\u591A\u4E86\u5E7E\u9053\u767D\u75D5\u3002"
    hintText: "\u97CC\u5EA6\u662F\u6703\u88AB\u78E8\u640D\u7684\u2014\u2014\u5B83\u672C\u4F86\u5C31\u662F\u62FF\u4F86\u82B1\u7684\u3002"
  - title: "\u6C72\u6C34\u81EA\u4FDD"
    description: "\u628A\u9AD4\u5167\u7684\u6C34\u5168\u90E8\u8ABF\u51FA\u4F86\uFF0C\u7BC9\u6210\u4E00\u5C64\u6DBC\u610F\u3002\u5F97\u6709\u975E\u5E38\u591A\u7684\u6C34\u3002"
    requirements:
    - stat: 1
      comparison: 0
      tier: 2
    changes:
    - stat: 1
      amount: -3
    - stat: 2
      amount: -1
    lockedText: 
    resultText: "\u6C34\u6C23\u4E00\u96E2\u958B\u8EAB\u9AD4\u5C31\u88AB\u98A8\u541E\u6389\u3002\u4F60\u6D3B\u4E86\u4E0B\u4F86\uFF0C\u537B\u50CF\u88AB\u64F0\u904E\u4E00\u6A23\uFF0C\u8449\u7DE3\u88C2\u958B\u4E86\u7D30\u7D0B\u3002"
    hintText: "\u5728\u4E7E\u5730\uFF0C\u6EFF\u8EAB\u7684\u6C34\u662F\u8CA0\u64D4\u3002\u8D8A\u6EBC\uFF0C\u98A8\u8981\u8D70\u7684\u8D8A\u591A\u3002"
