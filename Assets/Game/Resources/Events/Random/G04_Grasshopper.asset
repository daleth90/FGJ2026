    resultText: "\u4F60\u8FFD\u4E0A\u4E86\uFF0C\u751A\u81F3\u8D85\u904E\u4E86\u7260\u3002\u5598\u6C23\u7684\u6642\u5019\uFF0C\u8EAB\u4E0A\u7684\u6C34\u6C23\u6563\u4E86\u4E00\u4E9B\u3002"
