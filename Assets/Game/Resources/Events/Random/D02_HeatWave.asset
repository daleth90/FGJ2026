    lockedText: 
    resultText: "\u6C34\u4E00\u96E2\u958B\u8EAB\u9AD4\u5C31\u88AB\u71B1\u6D6A\u541E\u6389\u3002\u4F60\u6DBC\u4E86\u4E00\u77AC\u9593\uFF0C\u7136\u5F8C\u6BD4\u4E4B\u524D\u66F4\u4E7E\u3002"
    hintText: "\u5728\u4E7E\u5730\uFF0C\u6EFF\u8EAB\u7684\u6C34\u53EA\u6703\u88AB\u4E00\u53E3\u4E00\u53E3\u8981\u8D70\u3002"
