    - stat: 2
      amount: 1
    - stat: 1
      amount: -1
    lockedText: 
    resultText: "\u4F60\u628A\u81EA\u5DF1\u6372\u6210\u4E00\u6839\u7D30\u7D30\u7684\u91DD\u3002\u71B1\u6D6A\u8D70\u4E86\uFF0C\u4F60\u6162\u6162\u9B06\u958B\u3002"
    hintText: "\u6490\u904E\u53BB\u4E86\uFF0C\u6C34\u9084\u662F\u5C11\u4E86\u4E00\u9EDE\u3002\u4E7E\u5730\u88E1\u6C92\u6709\u767D\u6490\u7684\u3002"
  - title: "\u6C72\u51FA\u6C34\u5206\u964D\u6EAB"
    description: "\u9AD4\u5167\u7684\u6C34\u5920\u591A\uFF0C\u624D\u6490\u5F97\u8D77\u9019\u7A2E\u63EE\u970D\u3002"
