      amount: 2
    - stat: 1
      amount: -1
    lockedText: 
    resultText: "\u4F60\u885D\u4E86\u51FA\u4F86\uFF0C\u80CC\u5F8C\u7684\u7A7A\u6C23\u9084\u5728\u6643\u3002\u8EAB\u4E0A\u5C11\u4E86\u4E00\u9EDE\u6C34\u6C23\u3002"
    hintText: "\u5FEB\uFF0C\u53EF\u4EE5\u5C11\u66EC\u4E00\u9EDE\u2014\u2014\u4F46\u4E0D\u6703\u5B8C\u5168\u4E0D\u66EC\u3002"
  - title: "\u6372\u8D77\u8449\u7247\u786C\u6490"
