      tier: 1
    changes:
    - stat: 0
      amount: 2
    - stat: 2
      amount: -1
    lockedText: 
    resultText: "\u4F60\u885D\u4E0A\u53BB\u4E86\uFF0C\u4E2D\u9014\u9084\u662F\u6454\u4E86\u4E00\u4E0B\uFF0C\u819D\u84CB\u78E8\u6389\u4E00\u5C64\u76AE\u3002"
    hintText: "\u5FEB\u662F\u5FEB\uFF0C\u6EBC\u6ED1\u7684\u5730\u65B9\u7E3D\u6703\u6536\u4E00\u9EDE\u4EE3\u50F9\u3002"
  - title: "\u548C\u9752\u82D4\u64E0\u4E00\u64E0"
    description: "\u5920\u6EBC\u6F64\uFF0C\u624D\u878D\u5F97\u9032\u53BB\u3002"
