      amount: 1
    - stat: 1
      amount: 1
    lockedText: 
    resultText: "\u4F60\u8D70\u5F97\u5F88\u6162\uFF0C\u6BCF\u4E00\u6B65\u90FD\u9677\u9032\u9752\u82D4\u88E1\u3002\u8D70\u5230\u9802\u7684\u6642\u5019\uFF0C\u4F60\u8EAB\u4E0A\u4E5F\u662F\u7DA0\u7684\u3002"
    hintText: "\u7A69\u7A69\u5730\u8D70\uFF0C\u6EBC\u6C23\u4E5F\u6703\u8DDF\u8457\u4F60\u3002"
  - title: "\u4E00\u53E3\u6C23\u885D\u4E0A\u53BB"
