    - stat: 1
      comparison: 0
      tier: 2
    changes:
    - stat: 2
      amount: 2
    - stat: 1
      amount: 1
    lockedText: 
    resultText: "\u9752\u82D4\u8B93\u51FA\u4E86\u4E00\u9EDE\u4F4D\u7F6E\u3002\u4F60\u5011\u64E0\u5728\u4E00\u8D77\uFF0C\u5206\u4E0D\u6E05\u8AB0\u662F\u8AB0\u3002"
    hintText: "\u6EBC\u5730\u6703\u5584\u5F85\u5C6C\u65BC\u5B83\u7684\u8349\u3002"
