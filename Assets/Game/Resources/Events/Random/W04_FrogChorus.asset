  title: "\u86D9\u9CF4"
  description: "\u5929\u9ED1\u4E86\uFF0C\u6C34\u908A\u97FF\u8D77\u4E00\u7247\u86D9\u9CF4\u3002\u7260\u5011\u4E0D\u662F\u5728\u53EB\u4F60\uFF0C\u4F46\u4F60\u4E5F\u7761\u4E0D\u8457\u3002"
  options:
  - title: "\u8DDF\u8457\u7BC0\u62CD\u6416\u6643"
    description: "\u4E00\u4E0B\uFF0C\u4E00\u4E0B\uFF0C\u50CF\u5728\u539F\u5730\u5954\u8DD1\u3002"
    requirements: []
    changes:
    - stat: 0
      amount: 1
    lockedText: 
    resultText: "\u4F60\u6416\u4E86\u4E00\u6574\u591C\uFF0C\u5929\u4EAE\u6642\u8173\u6B65\u6BD4\u6628\u5929\u8F15\u5FEB\u3002"
    hintText: "\u6709\u4E9B\u6210\u9577\uFF0C\u662F\u5728\u4E0D\u77E5\u4E0D\u89BA\u88E1\u767C\u751F\u7684\u3002"
  - title: "\u628A\u8072\u97F3\u7576\u6210\u98A8\uFF0C\u7DF4\u7FD2\u7AD9\u7A69"
    description: "\u8072\u97F3\u63A8\u4E0D\u5012\u8349\uFF0C\u4F46\u53EF\u4EE5\u5047\u88DD\u3002"
    requirements: []
    changes:
    - stat: 2
      amount: 1
    lockedText: 
    resultText: "\u4F60\u5728\u86D9\u9CF4\u88E1\u7AD9\u4E86\u4E00\u6574\u591C\uFF0C\u4E00\u6B21\u4E5F\u6C92\u6709\u6643\u3002"
    hintText: "\u7AD9\u8457\uFF0C\u4E5F\u662F\u4E00\u7A2E\u7DF4\u7FD2\u3002"
  - title: "\u8B93\u591C\u88E1\u7684\u6C34\u6C23\u6EF2\u9032\u4F86"
    description: "\u8EAB\u4E0A\u672C\u4F86\u5C31\u6709\u6C34\u6C23\uFF0C\u624D\u7559\u5F97\u4F4F\u66F4\u591A\u3002"
    requirements:
    - stat: 1
      comparison: 0
      tier: 0
    changes:
    - stat: 1
      amount: 2
    lockedText: 
    resultText: "\u9727\u5F9E\u6C34\u9762\u5347\u8D77\u4F86\uFF0C\u4E00\u9EDE\u4E00\u9EDE\u6EF2\u9032\u4F60\u7684\u8449\u8108\u3002"
    hintText: "\u4F60\u66F4\u6EBC\u6F64\u4E86\u3002\u5728\u9019\u88E1\u662F\u597D\u4E8B\u3002"
