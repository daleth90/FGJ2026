    lockedText: 
    resultText: "\u88C2\u7E2B\u6DF1\u8655\u771F\u7684\u9084\u6709\u4E00\u9EDE\u6EBC\u6CE5\u3002\u4F60\u559D\u5230\u4E86\uFF0C\u8449\u5B50\u4E5F\u88AB\u6CE5\u6BBC\u522E\u50B7\u4E86\u3002"
    hintText: "\u5728\u4E7E\u5730\u5B58\u6C34\uFF0C\u7E3D\u8981\u62FF\u5225\u7684\u6771\u897F\u53BB\u63DB\u3002"
