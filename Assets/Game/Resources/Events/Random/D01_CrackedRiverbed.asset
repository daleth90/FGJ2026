    lockedText: 
    resultText: "\u788E\u7247\u522E\u8457\u4F60\u7684\u8396\u3002\u4F60\u8D70\u904E\u53BB\u4E86\uFF0C\u4E5F\u88AB\u98A8\u4E7E\u4E86\u4E00\u4E9B\u3002"
    hintText: "\u97CC\u5EA6\u80FD\u5E36\u4F60\u904E\u53BB\uFF0C\u4F46\u4E7E\u5730\u7E3D\u6703\u6536\u4E00\u9EDE\u6C34\u7576\u904E\u8DEF\u8CBB\u3002"
