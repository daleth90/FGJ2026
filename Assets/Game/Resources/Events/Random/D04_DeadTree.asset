  title: "\u67AF\u6A39\u7684\u5F71\u5B50"
  description: "\u4E00\u68F5\u65E9\u5C31\u6B7B\u53BB\u7684\u6A39\uFF0C\u9084\u7AD9\u5728\u90A3\u88E1\u3002\u5B83\u7D66\u4E0D\u4E86\u8449\u5B50\uFF0C\u4F46\u9084\u7D66\u5F97\u4E86\u5F71\u5B50\u3002"
  options:
  - title: "\u5728\u5F71\u5B50\u88E1\u6B47\u4E00\u6703"
    description: "\u5F71\u5B50\u5F88\u7A84\uFF0C\u4F46\u5920\u4E00\u682A\u8349\u8EB2\u3002"
    requirements: []
    changes:
    - stat: 1
      amount: 1
    lockedText: 
    resultText: "\u4F60\u8EB2\u5728\u90A3\u4E00\u9053\u7D30\u7D30\u7684\u9670\u5F71\u88E1\uFF0C\u5B88\u4F4F\u4E86\u4E00\u9EDE\u6C34\u6C23\u3002"
    hintText: "\u5728\u4E7E\u5730\uFF0C\u80FD\u4E0D\u5931\u53BB\u5C31\u7B97\u8CFA\u5230\u3002"
  - title: "\u6CBF\u8457\u5B83\u7684\u6839\u5F80\u4E0B\u63A2"
    description: "\u4E7E\u571F\u5F88\u786C\uFF0C\u6839\u5920\u5F37\u97CC\u624D\u947D\u5F97\u52D5\u3002"
    requirements:
    - stat: 2
      comparison: 0
      tier: 1
    changes:
    - stat: 1
      amount: 2
    lockedText: 
    resultText: "\u5B83\u7684\u6839\u65E9\u5C31\u7A7A\u4E86\uFF0C\u537B\u66FF\u4F60\u7559\u4E0B\u4E00\u689D\u901A\u5F80\u6DF1\u8655\u7684\u8DEF\u3002\u90A3\u88E1\u9084\u6709\u6C34\u3002"
    hintText: "\u97CC\u5EA6\u4E0D\u53EA\u662F\u7528\u4F86\u6328\u6253\u7684\uFF0C\u5B83\u4E5F\u80FD\u66FF\u4F60\u627E\u6C34\u3002"
  - title: "\u5B78\u5B83\u600E\u9EBC\u7AD9\u8457"
    description: "\u6C92\u6709\u6C34\u3001\u6C92\u6709\u8449\u5B50\uFF0C\u537B\u9084\u7AD9\u8457\u3002"
    requirements: []
    changes:
    - stat: 2
      amount: 2
    - stat: 1
      amount: -1
    lockedText: 
    resultText: "\u4F60\u770B\u4E86\u5B83\u5F88\u4E45\uFF0C\u5B78\u5230\u4E86\u4E00\u9EDE\u4EC0\u9EBC\u3002\u98A8\u518D\u5439\u904E\u4F86\u7684\u6642\u5019\uFF0C\u4F60\u6C92\u6709\u6643\u3002"
    hintText: "\u66F4\u786C\uFF0C\u4E5F\u66F4\u4E7E\u4E86\u3002"
