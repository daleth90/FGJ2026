  title: "\u6C99\u5875"
  description: "\u98A8\u6372\u8D77\u4E00\u6574\u7247\u6C99\uFF0C\u5929\u5730\u4E4B\u9593\u53EA\u5269\u4E0B\u4E00\u7A2E\u984F\u8272\u3002"
  options:
  - title: "\u8D81\u6C99\u7246\u5408\u650F\u524D\u885D\u51FA\u53BB"
    description: "\u53EA\u6709\u6700\u5FEB\u7684\u8349\u627E\u5F97\u5230\u90A3\u9053\u7E2B\u3002"
    requirements:
    - stat: 0
      comparison: 0
      tier: 2
    changes:
    - stat: 0
      amount: 2
    - stat: 2
      amount: 1
    lockedText: 
    resultText: "\u4F60\u5F9E\u5169\u9053\u6C99\u7246\u4E4B\u9593\u7A7F\u4E86\u51FA\u53BB\uFF0C\u8EAB\u5F8C\u7684\u4E16\u754C\u8F5F\u5730\u5408\u4E0A\u3002"
    hintText: "\u5920\u5FEB\u7684\u8A71\uFF0C\u5F88\u591A\u4E8B\u60C5\u6839\u672C\u8FFD\u4E0D\u4E0A\u4F60\u3002"
  - title: "\u4F0F\u5728\u539F\u5730\uFF0C\u8B93\u6C99\u57CB\u4E00\u534A"
    description: "\u5920\u5F37\u97CC\u624D\u57CB\u5F97\u4F4F\uFF0C\u4E5F\u624D\u722C\u5F97\u51FA\u4F86\u3002"
    requirements:
    - stat: 2
      comparison: 0
      tier: 1
    changes:
    - stat: 2
      amount: 2
    - stat: 0
      amount: -1
    lockedText: 
    resultText: "\u6C99\u4E00\u5C64\u4E00\u5C64\u84CB\u4E0A\u4F86\u3002\u7B49\u98A8\u505C\u4E86\uFF0C\u4F60\u628A\u81EA\u5DF1\u5F9E\u6C99\u88E1\u62D4\u51FA\u4F86\uFF0C\u6BD4\u4E4B\u524D\u66F4\u6C89\u3001\u66F4\u7A69\u3002"
    hintText: "\u786C\u6490\u8B93\u4F60\u66F4\u7D50\u5BE6\uFF0C\u4E5F\u8B93\u4F60\u6162\u4E86\u4E0B\u4F86\u3002"
  - title: "\u8B93\u6C99\u5F9E\u8EAB\u4E0A\u6ED1\u904E\u53BB"
    description: "\u8EAB\u4E0A\u4E7E\u723D\uFF0C\u6C99\u5C31\u9ECF\u4E0D\u4F4F\u3002"
    requirements:
    - stat: 1
      comparison: 1
      tier: 0
    changes:
    - stat: 0
      amount: 1
    - stat: 2
      amount: 1
    lockedText: 
    resultText: "\u6C99\u6253\u5728\u4F60\u8EAB\u4E0A\uFF0C\u53C8\u6ED1\u8D70\u4E86\uFF0C\u4EC0\u9EBC\u4E5F\u6C92\u7559\u4E0B\u3002"
    hintText: "\u4E7E\uFF0C\u5728\u9019\u88E1\u662F\u4E00\u7A2E\u672C\u4E8B\u3002"
