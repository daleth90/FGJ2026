  title: "\u5FFD\u7136\u7684\u51B0\u96F9"
  description: "\u5929\u8272\u4E00\u6697\uFF0C\u51B0\u7C92\u5F9E\u96F2\u88E1\u7838\u4E0B\u4F86\u3002\u5B83\u5011\u4E0D\u5927\uFF0C\u4F46\u6BCF\u4E00\u9846\u90FD\u662F\u786C\u7684\u3002"
  options:
  - title: "\u633A\u76F4\u4E86\u63A5\u4F4F"
    description: "\u5920\u5F37\u97CC\u7684\u8396\uFF0C\u51B0\u96F9\u53EA\u662F\u5728\u66FF\u5B83\u6309\u6469\u3002"
    requirements:
    - stat: 2
      comparison: 0
      tier: 1
    changes:
    - stat: 2
      amount: 2
    - stat: 1
      amount: 1
    lockedText: 
    resultText: "\u51B0\u7C92\u5728\u4F60\u8EAB\u4E0A\u5F48\u958B\uFF0C\u788E\u6210\u6C34\uFF0C\u9806\u8457\u8449\u8108\u6D41\u9032\u6839\u88E1\u3002"
    hintText: "\u6490\u5F97\u4F4F\uFF0C\u9023\u707D\u96E3\u90FD\u80FD\u8B8A\u6210\u990A\u5206\u3002"
  - title: "\u5F4E\u4E0B\u8170\u8B93\u5B83\u6ED1\u904E"
    description: "\u4E0D\u786C\u78B0\uFF0C\u53EA\u8981\u4E0D\u6298\u65B7\u3002"
    requirements:
    - stat: 2
      comparison: 0
      tier: 0
    changes:
    - stat: 2
      amount: 1
    lockedText: 
    resultText: "\u4F60\u5F4E\u5F97\u5F88\u4F4E\uFF0C\u51B0\u96F9\u8CBC\u8457\u4F60\u7684\u80CC\u6EFE\u4E86\u4E0B\u53BB\u3002"
    hintText: "\u5F4E\u800C\u4E0D\u6298\uFF0C\u4E5F\u662F\u4E00\u7A2E\u97CC\u3002"
  - title: "\u6328\u5E7E\u4E0B\uFF0C\u8D95\u5FEB\u8DD1\u958B"
    description: "\u6703\u75DB\uFF0C\u4F46\u7E3D\u6BD4\u7AD9\u8457\u6328\u6253\u597D\u3002"
    requirements: []
    changes:
    - stat: 0
      amount: 1
    - stat: 2
      amount: -1
    lockedText: 
    resultText: "\u4F60\u88AB\u7838\u4E2D\u4E86\u5E7E\u4E0B\uFF0C\u4E00\u7638\u4E00\u62D0\u5730\u885D\u51FA\u4E86\u96F2\u7684\u7BC4\u570D\u3002"
    hintText: "\u4F60\u8EAB\u4E0A\u591A\u4E86\u50B7\u3002\u518D\u9019\u6A23\u6328\u4E0B\u53BB\uFF0C\u7E3D\u6709\u6490\u4E0D\u4F4F\u7684\u4E00\u5929\u3002"
