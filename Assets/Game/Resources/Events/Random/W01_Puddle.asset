  title: "\u7A4D\u6C34\u7684\u7AAA\u5730"
  description: "\u96E8\u505C\u4E86\uFF0C\u4F4E\u8655\u7559\u4E0B\u4E00\u9762\u6C34\u3002\u6C34\u5F88\u6DFA\uFF0C\u537B\u4E00\u773C\u671B\u4E0D\u5230\u5C0D\u5CB8\u3002"
  options:
  - title: "\u6D89\u6C34\u800C\u904E"
    description: "\u8EAB\u9AD4\u5920\u6EBC\u6F64\u7684\u8349\uFF0C\u5728\u6C34\u88E1\u53CD\u800C\u81EA\u5728\u3002"
    requirements:
    - stat: 1
      comparison: 0
      tier: 1
    changes:
    - stat: 1
      amount: 1
    - stat: 0
      amount: 1
    lockedText: 
    resultText: "\u6C34\u6C92\u904E\u4F60\u7684\u8170\u3002\u4F60\u8D70\u5F97\u5F88\u7A69\uFF0C\u50CF\u56DE\u5230\u4E86\u4E00\u500B\u719F\u6089\u7684\u5730\u65B9\u3002"
    hintText: "\u5728\u6EBC\u5730\uFF0C\u6C34\u662F\u8DEF\uFF0C\u4E0D\u662F\u963B\u7919\u3002"
  - title: "\u8E29\u8457\u77F3\u982D\u8DF3\u904E\u53BB"
    description: "\u77F3\u982D\u4E4B\u9593\u9694\u5F97\u5F88\u9060\uFF0C\u5F97\u5920\u5FEB\u3002"
    requirements:
    - stat: 0
      comparison: 0
      tier: 1
    changes:
    - stat: 0
      amount: 2
    lockedText: 
    resultText: "\u4E00\u3001\u4E8C\u3001\u4E09\u3002\u4F60\u5728\u6700\u5F8C\u4E00\u9846\u77F3\u982D\u4E0A\u6ED1\u4E86\u4E00\u4E0B\uFF0C\u4F46\u6C92\u6709\u6389\u4E0B\u53BB\u3002"
    hintText: "\u5920\u5FEB\u5C31\u4E0D\u5FC5\u5F04\u6EBC\u81EA\u5DF1\u3002"
  - title: "\u6CE1\u5728\u6C34\u908A\u7B49\u5B83\u9000"
    description: "\u4E0D\u8D95\u6642\u9593\u7684\u8A71\uFF0C\u6C34\u7E3D\u6703\u9000\u7684\u3002"
    requirements: []
    changes:
    - stat: 1
      amount: 2
    - stat: 0
      amount: -1
    lockedText: 
    resultText: "\u4F60\u7B49\u4E86\u5F88\u4E45\u3002\u6C34\u9000\u7684\u6642\u5019\uFF0C\u4F60\u6574\u682A\u90FD\u662F\u6C89\u7538\u7538\u7684\u3002"
    hintText: "\u5438\u98FD\u4E86\u6C34\uFF0C\u8173\u6B65\u4E5F\u91CD\u4E86\u3002"
