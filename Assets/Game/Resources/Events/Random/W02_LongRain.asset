  title: "\u9023\u65E5\u7684\u96E8"
  description: "\u96E8\u5DF2\u7D93\u4E0B\u4E86\u5F88\u591A\u5929\u3002\u571F\u662F\u8EDF\u7684\uFF0C\u98A8\u662F\u6EBC\u7684\uFF0C\u9023\u5149\u90FD\u662F\u7070\u7684\u3002"
  options:
  - title: "\u5F35\u958B\u8449\u7247\u76E1\u60C5\u559D"
    description: "\u80FD\u559D\u591A\u5C11\uFF0C\u5C31\u559D\u591A\u5C11\u3002"
    requirements: []
    changes:
    - stat: 1
      amount: 3
    - stat: 2
      amount: -1
    lockedText: 
    resultText: "\u4F60\u559D\u5230\u767C\u8139\uFF0C\u8396\u8B8A\u5F97\u53C8\u8EDF\u53C8\u91CD\u3002"
    hintText: "\u5728\u6EBC\u5730\u9019\u4E0D\u7B97\u4EC0\u9EBC\u2014\u2014\u53EA\u8981\u4F60\u4E00\u76F4\u5F85\u5728\u6EBC\u5730\u3002"
  - title: "\u628A\u6839\u624E\u9032\u786C\u4E00\u9EDE\u7684\u571F"
    description: "\u8EDF\u571F\u7559\u4E0D\u4F4F\u8349\uFF0C\u5F97\u5920\u5F37\u97CC\u624D\u63A2\u5F97\u5230\u5E95\u3002"
    requirements:
    - stat: 2
      comparison: 0
      tier: 1
    changes:
    - stat: 2
      amount: 2
    lockedText: 
    resultText: "\u4F60\u7A7F\u904E\u721B\u6CE5\uFF0C\u78B0\u5230\u4E86\u5E95\u4E0B\u90A3\u5C64\u786C\u571F\u3002\u5F9E\u6B64\u96E8\u518D\u5927\uFF0C\u4F60\u4E5F\u4E0D\u6703\u88AB\u6C96\u8D70\u3002"
    hintText: "\u624E\u5F97\u6DF1\u7684\u8349\uFF0C\u4E0D\u6015\u6C34\u4F86\u3002"
  - title: "\u5728\u96E8\u7684\u7A7A\u9699\u4E4B\u9593\u5954\u8DD1"
    description: "\u53EA\u6709\u6700\u5FEB\u7684\u8349\uFF0C\u624D\u6DCB\u4E0D\u5230\u96E8\u3002"
    requirements:
    - stat: 0
      comparison: 0
      tier: 2
    changes:
    - stat: 0
      amount: 3
    lockedText: 
    resultText: "\u96E8\u6EF4\u843D\u4E0B\u4F86\u7684\u6642\u5019\uFF0C\u4F60\u5DF2\u7D93\u4E0D\u5728\u90A3\u88E1\u4E86\u3002"
    hintText: "\u5FEB\u5230\u4E00\u500B\u7A0B\u5EA6\uFF0C\u9023\u96E8\u90FD\u662F\u6162\u7684\u3002"
