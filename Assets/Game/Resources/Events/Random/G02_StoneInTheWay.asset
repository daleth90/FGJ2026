  title: "\u64CB\u8DEF\u7684\u77F3\u982D"
  description: "\u8DEF\u4E2D\u9593\u8EBA\u8457\u4E00\u584A\u66EC\u6696\u7684\u77F3\u982D\u3002\u7E5E\u904E\u53BB\u5F88\u9060\uFF0C\u7FFB\u904E\u53BB\u5F88\u786C\u3002"
  options:
  - title: "\u52A9\u8DD1\uFF0C\u4E00\u8E8D\u800C\u904E"
    description: "\u53EA\u6709\u5920\u5FEB\u7684\u8349\u624D\u6709\u9019\u7A2E\u9918\u88D5\u3002"
    requirements:
    - stat: 0
      comparison: 0
      tier: 2
    changes:
    - stat: 0
      amount: 3
    lockedText: 
    resultText: "\u4F60\u5E7E\u4E4E\u6C92\u6709\u78B0\u5230\u5B83\u3002\u843D\u5730\u7684\u6642\u5019\uFF0C\u98A8\u9084\u8DDF\u5728\u4F60\u5F8C\u9762\u3002"
    hintText: "\u5920\u5FEB\u7684\u6642\u5019\uFF0C\u969C\u7919\u53EA\u662F\u98A8\u666F\u3002"
  - title: "\u8CBC\u8457\u77F3\u9762\u722C\u904E\u53BB"
    description: "\u7C97\u7CD9\u7684\u77F3\u9762\u6703\u78E8\u4F60\uFF0C\u4F46\u78E8\u4E0D\u65B7\u4F60\u3002"
    requirements:
    - stat: 2
      comparison: 0
      tier: 1
    changes:
    - stat: 2
      amount: 2
    lockedText: 
    resultText: "\u4F60\u4E00\u5BF8\u4E00\u5BF8\u7FFB\u4E86\u904E\u53BB\uFF0C\u8EAB\u4E0A\u591A\u4E86\u5E7E\u9053\u6DFA\u75D5\uFF0C\u4E5F\u591A\u4E86\u4E00\u9EDE\u5E95\u6C23\u3002"
    hintText: "\u78E8\u904E\u7684\u5730\u65B9\uFF0C\u6703\u9577\u5F97\u66F4\u786C\u3002"
  - title: "\u7E5E\u9060\u8DEF"
    description: "\u9060\u8DEF\u4E0A\u6C92\u6709\u906E\u852D\u3002"
    requirements: []
    changes:
    - stat: 1
      amount: -1
    lockedText: 
    resultText: "\u4F60\u7E5E\u4E86\u5F88\u4E45\u3002\u592A\u967D\u4E00\u8DEF\u66EC\u8457\u4F60\uFF0C\u5E36\u8D70\u4E86\u4E00\u9EDE\u6C34\u6C23\u3002"
    hintText: "\u7E5E\u5F97\u904E\u53BB\uFF0C\u4F46\u6BCF\u4E00\u6B21\u7E5E\u8DEF\u90FD\u6709\u4EE3\u50F9\u3002"
